# Exemple de configuration Docker Compose locale pour CloudCollectionApp.
# Copiez ce fichier vers `runtime/.env`, puis adaptez les valeurs locales.
# Les secrets locaux sont fournis par variables d'environnement Docker Compose.
# Ne versionnez jamais `runtime/.env`.

# =============================================================================
# APPLICATION ET EXPOSITION HTTP LOCALE
# =============================================================================
# Port HTTP expose localement par le service web.
WEB_PORT=8080
# URL publique backend utilisee dans les emails et callbacks locaux.
BACKEND_PUBLIC_URL=http://localhost:8080
# URL publique frontend utilisee dans les emails et redirections locaux.
FRONTEND_PUBLIC_URL=http://localhost:8080

# =============================================================================
# ARBORESCENCE DE TRAVAIL LOCALE
# =============================================================================
# Repertoire parent commun des donnees de travail locales.
APPLICATION_WORKDIR=../runtime-data

# =============================================================================
# FICHIERS UTILISATEUR ET LIMITES D UPLOAD
# =============================================================================
# Repertoire hote contenant les fichiers de collection importes.
# Par defaut: ${APPLICATION_WORKDIR}/users-workspace.
# Taille maximale d'upload d'un fichier de collection, en octets.
USER_COLLECTION_MAX_UPLOAD_BYTES=104857600

# =============================================================================
# IMAGES DE PLATEFORMES
# =============================================================================
# Repertoire conteneur utilise par le backend pour stocker les images.
BACKEND_IMG_DIR=/images
# Repertoire hote monte dans `BACKEND_IMG_DIR`.
# Par defaut: ${APPLICATION_WORKDIR}/images.
# Taille maximale d'upload d'une image de plateforme, en octets.
PLATFORM_IMAGE_MAX_UPLOAD_BYTES=10485760
# Nombre maximal d'images de plateformes en attente par utilisateur.
PLATFORM_IMAGE_MAX_PENDING_IMAGES_PER_USER=20
# Volume maximal des images de plateformes en attente par utilisateur, en octets.
PLATFORM_IMAGE_MAX_PENDING_BYTES_PER_USER=52428800
# Volume maximal total autorise pour les images de plateformes, en octets.
PLATFORM_IMAGE_MAX_TOTAL_BYTES=1073741824

# =============================================================================
# MATCHING D'IMPORT
# =============================================================================
# Seuil bas du matching des plateformes, avec verification administrateur.
PLATFORM_MATCHING_LOW_LVL_RATING=25
# Seuil haut du matching des plateformes, sans verification administrateur.
PLATFORM_MATCHING_HIGH_LEVEL_RATING=75
# Seuil bas du matching des studios existants.
STUDIO_MATCHING_LOW_LVL_RATING=25
# Seuil haut requis pour rattacher automatiquement un studio existant.
STUDIO_MATCHING_HIGH_LEVEL_RATING=87
# Seuil bas du matching des jeux existants.
GAME_MATCHING_LOW_LVL_RATING=25
# Seuil haut requis pour rattacher automatiquement un jeu existant.
GAME_MATCHING_HIGH_LEVEL_RATING=75
# Seuil minimal de matching des regions importees.
REGION_MATCH_LIMIT=60
# Seuil minimal de matching des etats importes.
ETAT_MATCH_LIMIT=60

# =============================================================================
# LOGS BACKEND
# =============================================================================
# Niveau de log du backend.
BACKEND_LOG_LEVEL=INFO
# Active l'ecriture des logs backend dans un fichier.
BACKEND_LOG_FILE_ENABLED=true
# Repertoire hote recevant les fichiers de log backend.
# Par defaut: ${APPLICATION_WORKDIR}/logs.
# Nom du fichier de log backend.
BACKEND_LOG_FILE_NAME=backend.log
# Taille maximale du fichier de log avant rotation, en octets.
BACKEND_LOG_FILE_MAX_BYTES=10485760
# Nombre de fichiers de log conserves apres rotation.
BACKEND_LOG_FILE_BACKUP_COUNT=30

# =============================================================================
# AUTHENTIFICATION APPLICATIVE LOCALE
# =============================================================================
# Duree de validite des tokens applicatifs, en secondes.
AUTH_TOKEN_TTL_SECONDS=3600
# Identifiant du compte administrateur technique.
AUTH_USERNAME=admin
# Cle de chiffrement generee avec `scripts/generate_auth_env.py`.
AUTH_ENV_ENCRYPTION_KEY=generer-avec-scripts/generate_auth_env.py
# Mot de passe administrateur chiffre.
AUTH_PASSWORD_ENCRYPTED=fernet:generer-avec-scripts/generate_auth_env.py
# Secret de signature applicatif chiffre.
AUTH_SECRET_KEY_ENCRYPTED=fernet:generer-avec-scripts/generate_auth_env.py
# Active la validation administrateur des nouveaux comptes.
ADMIN_ACCOUNT_VALIDATION_ENABLED=true
# Duree de validite des tokens de verification email, en heures.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# =============================================================================
# BASE DE DONNEES LOCALE
# =============================================================================
# Schema PostgreSQL applicatif.
DB_SCHEMA_NAME=cloudcollectionapp
# Base PostgreSQL creee par le conteneur.
POSTGRES_DB=cloudcollectionapp
# Utilisateur PostgreSQL.
POSTGRES_USER=cloudcollectionapp
# Port PostgreSQL expose localement.
POSTGRES_PORT=5432
# Mot de passe PostgreSQL local.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
# Mot de passe PostgreSQL chiffre pour les usages applicatifs locaux.
POSTGRES_PASSWORD_ENCRYPTED=fernet:generer-avec-scripts/generate_auth_env.py

# =============================================================================
# EMAIL LOCAL AVEC MAILPIT
# =============================================================================
# Port web local de Mailpit.
MAILPIT_WEB_PORT=8025
# Port SMTP local de Mailpit.
MAILPIT_SMTP_PORT=1025
# Mode d'envoi email local.
LOCAL_EMAIL_DELIVERY_MODE=smtp
# Adresse expediteur locale.
LOCAL_SMTP_FROM_EMAIL=noreply@cloudcollectionapp.local
# Hote SMTP local.
LOCAL_SMTP_HOST=mailpit
# Port SMTP local.
LOCAL_SMTP_PORT=1025
# Identifiant SMTP local, vide avec Mailpit.
LOCAL_SMTP_USERNAME=
# Mot de passe SMTP local, vide avec Mailpit.
LOCAL_SMTP_PASSWORD=
# Active TLS pour le SMTP local.
LOCAL_SMTP_USE_TLS=false

# =============================================================================
# EMAIL APPLICATIF LOCAL
# =============================================================================
# Destinataire local des notifications administrateur.
ADMIN_NOTIFICATION_EMAIL=admin@cloudcollectionapp.local
